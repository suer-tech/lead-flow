# Vercel Neon integration usually creates one of these automatically.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required on Vercel. Never commit real values.
CRM_PASSWORD=choose-a-strong-password
CRM_SECRET_KEY=generate-a-long-random-string

# Separate server-to-server token; never expose to frontend JavaScript.
CRM_AGENT_TOKEN=
CRM_SENDER_EMAIL=ai.studio.ufa@mail.ru
CRM_OUTREACH_ENABLED=0
CRM_AUTO_APPROVE=0
CRM_NO_REPLY_ARCHIVE_ENABLED=0
CRM_NO_REPLY_DAYS=14
